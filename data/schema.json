{
  "$comment": "Machine-readable description of the two data files. scripts/validate-dates.mjs enforces the same rules by hand, so nothing here is needed at runtime.",
  "dates": {
    "type": "array",
    "items": {
      "type": "object",
      "additionalProperties": false,
      "required": ["date", "title"],
      "properties": {
        "id": { "type": "string", "description": "Stable id, required when repeat != none so renaming a title keeps the same identity." },
        "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "YYYY-MM-DD. For repeat=yearly only the month and day are used." },
        "title": { "type": "string", "minLength": 1, "maxLength": 80 },
        "repeat": { "enum": ["none", "yearly"], "default": "none" },
        "leadDays": { "type": ["integer", "null"], "minimum": 0, "maximum": 366, "description": "Start reminding this many days early. null/absent = use noticeLeadDays from config.json." },
        "note": { "type": "string", "maxLength": 400 },
        "color": { "enum": ["blue", "green", "amber", "rose", "violet"] },
        "active": { "type": "boolean", "default": true }
      }
    }
  },
  "config": {
    "type": "object",
    "required": ["timezone"],
    "properties": {
      "timezone": { "type": "string", "description": "IANA zone, e.g. Asia/Shanghai." },
      "noticeLeadDays": { "type": "integer", "minimum": 0, "maximum": 366, "default": 0 },
      "upcomingLimit": { "type": "integer", "minimum": 1, "maximum": 30, "default": 10 }
    }
  }
}
